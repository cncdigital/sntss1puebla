# Google Drive OAuth. Environment secrets override the encrypted client that an
# administrator can save from “Expedientes en Drive”.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# Optional destination folder. The app refuses to synchronize if this folder
# is unavailable or has broad access through a link or domain.
GOOGLE_DRIVE_ROOT_FOLDER_ID=1bkF-45NfWf2z-6TD_YUtG-9Ht5AsM_4V

# DeVi hybrid AI. Keep the API key server-side and store it as a production
# secret; it must never use a NEXT_PUBLIC_ prefix or reach the browser.
OPENAI_API_KEY=
OPENAI_DEVI_MODEL=gpt-5.6-luna
OPENAI_DEVI_TTS_MODEL=gpt-4o-mini-tts

# Meta Graph API · noticias automáticas. Keep every token and secret server-side.
# The webhook callback is /api/meta/webhook and subscribes to the Page `feed` field.
META_GRAPH_API_VERSION=v26.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Owner administrativo: nunca lo incluyas en el código público.
OWNER_EMAILS=
OWNER_MATRICULA=
