<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/sntss_blue">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SNTSS · SECCIÓN I PUEBLA" android:textColor="@color/sntss_gold"
            android:textSize="14sp" android:textStyle="bold" android:gravity="center" />
        <FrameLayout android:layout_width="280dp" android:layout_height="280dp"
            android:layout_marginTop="18dp">
            <ImageView android:id="@+id/song_cover" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"
                android:src="@drawable/ic_radio" android:contentDescription="@string/radio_title" />
            <TextView android:id="@+id/ghost_lyric" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_gravity="bottom"
                android:padding="16dp" android:gravity="center" android:maxLines="3"
                android:background="#B3071D36" android:textColor="#FFDA79"
                android:shadowColor="#000000" android:shadowRadius="8" android:shadowDx="1" android:shadowDy="2"
                android:textSize="25sp" android:textStyle="bold" android:visibility="gone" />
        </FrameLayout>
        <Button android:id="@+id/maximize_radio" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="@string/radio_maximize" />
        <TextView android:id="@+id/song_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:gravity="center" android:text="@string/radio_title" android:textColor="@android:color/white"
            android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/song_artist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:gravity="center" android:text="@string/radio_subtitle"
            android:textColor="#CADCE9" android:textSize="16sp" />
        <SeekBar android:id="@+id/song_seek" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="30dp"
            android:progressTint="@color/sntss_gold" android:thumbTint="@color/sntss_gold" />
        <TextView android:id="@+id/song_progress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:text="0:00 / 0:00"
            android:textColor="#CADCE9" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center">
            <Button android:id="@+id/previous_song" android:layout_width="wrap_content"
                android:layout_height="56dp" android:text="@string/radio_previous"
                android:contentDescription="@string/radio_previous" />
            <Button android:id="@+id/play_native_radio" android:layout_width="wrap_content"
                android:layout_height="56dp" android:layout_marginHorizontal="8dp"
                android:backgroundTint="@color/sntss_gold" android:text="@string/play_radio_car" />
            <Button android:id="@+id/next_song" android:layout_width="wrap_content"
                android:layout_height="56dp" android:text="@string/radio_next"
                android:contentDescription="@string/radio_next" />
        </LinearLayout>
        <TextView android:id="@+id/radio_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:gravity="center" android:text="@string/radio_ready"
            android:textColor="#CADCE9" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/song_lyrics_title"
            android:textColor="@color/sntss_gold" android:textSize="18sp" android:textStyle="bold" />
        <ScrollView android:id="@+id/lyrics_scroll" android:layout_width="match_parent"
            android:layout_height="240dp" android:layout_marginTop="8dp"
            android:background="#123751" android:fillViewport="true" android:nestedScrollingEnabled="true">
            <TextView android:id="@+id/song_lyrics" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="16dp"
                android:text="@string/song_lyrics_empty" android:textColor="@android:color/white"
                android:textSize="20sp" android:lineSpacingExtra="12dp" android:gravity="center" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
